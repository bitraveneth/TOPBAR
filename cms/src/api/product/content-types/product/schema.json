{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Product catalog entries for product pages"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "unique": true
    },
    "category": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "string"
    },
    "showcaseImagePosition": {
      "type": "string"
    },
    "specItems": {
      "type": "component",
      "repeatable": true,
      "component": "home.text-link-item"
    },
    "featuresEditor": {
      "type": "component",
      "repeatable": true,
      "component": "product.feature-item"
    },
    "featureShowcaseEditor": {
      "type": "component",
      "repeatable": true,
      "component": "product.feature-item"
    },
    "colorVariantsEditor": {
      "type": "component",
      "repeatable": true,
      "component": "product.color-variant"
    },
    "showProductFeaturesHeading": {
      "type": "boolean",
      "default": true
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "isNew": {
      "type": "boolean",
      "default": false
    }
  }
}
