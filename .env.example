# Copy to .env and fill in from Supabase → Project Settings → API
#
# 1) SQL: paste supabase/migrations/20260427000000_admin_newsletter.sql in SQL Editor and run
# 2) Create your first user (Auth → Users, or sign-up flow), then run:
#    update public.profiles set role = 'admin' where email = 'your@email.com';
# 3) Deploy Edge Function admin-create-user (needs service role in function secrets)
# 4) npm run dev → storefront; /admin → panel

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable (sb_publishable_…) or legacy anon JWT — Project Settings → API Keys
VITE_SUPABASE_ANON_KEY=

# CMS source mode:
# - auto: defaults -> Strapi -> Supabase overrides
# - strapi: defaults -> Strapi only
# - supabase: defaults -> Supabase only
VITE_CMS_SOURCE=auto
VITE_STRAPI_URL=http://localhost:1337

# Server-only (npm run create-admin). Never expose in the browser or commit real values.
# SUPABASE_SERVICE_ROLE_KEY=

# Never put the service role key in Vite-prefixed vars — only here for local scripts / Edge secrets.
