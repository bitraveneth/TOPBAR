# Pooled Prisma Postgres URL for the running API.
DATABASE_URL=postgresql://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require
# Direct URL used by Prisma migrations. Same credentials, non-pooled host.
DIRECT_URL=postgresql://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require

# Desk sign-in at /admin. Set both before deploying, and use a long password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Signs the admin session cookie.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
# Salt for hashing visitor IPs stored on verification attempts.
IP_HASH_SALT=change-me-to-a-long-random-string

PORT=4000
