{
  "name": "topbar",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file=.env --watch server/index.js",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"vite --host 0.0.0.0 --port 5173\" \"node --env-file=.env --watch server/index.js\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:verify": "node --test server/parseCode.test.js",
    "db:deploy": "prisma migrate deploy",
    "perf:summary": "node scripts/summarize-lighthouse.mjs home-mobile.json home-desktop.json product-mobile.json product-desktop.json",
    "images:mobile": "node scripts/generate-mobile-images.mjs"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/ubuntu": "^5.2.8",
    "@prisma/client": "^6.19.3",
    "express": "^4.22.3",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "prisma": "^6.19.3",
    "sharp": "^0.35.2",
    "vite": "^8.0.4"
  }
}
